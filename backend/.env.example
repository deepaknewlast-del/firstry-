[TEMPLATE]
# AI — NEVER on frontend
GEMINI_API_KEY=your_gemini_api_key

# Supabase — service role key (admin access, server only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Paddle Billing — fulfillment & provisioning
# API key from Developer tools > Authentication > API keys
# PADDLE_ENVIRONMENT must match the key: "sandbox" or "production"
PADDLE_API_KEY=pdl_sdbx_apikey_...
PADDLE_ENVIRONMENT=sandbox
# Signing secret from Developer tools > Notifications > your destination
# (starts with pdl_ntfset_) — NOT the API key
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
# Price IDs backing the pricing page (Developer tools > Catalog)
PADDLE_PRICE_MONTHLY=pri_...
PADDLE_PRICE_ANNUAL=pri_...
# Optional: direct Postgres URL for the local webhook test suite only
# (Supabase > Connect > Connection string). Leave empty to skip those tests.
DATABASE_URL=

# Stripe (legacy — kept until Paddle billing is live)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# App
ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
MAX_REQUEST_BYTES=131072
IP_GENERATION_DAILY_LIMIT=20
IP_BILLING_HOURLY_LIMIT=10

# Resend Email
RESEND_API_KEY=re_...
