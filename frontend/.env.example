# Frontend env — public keys only (safe to expose)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_API_URL=http://localhost:8000
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Paddle — client-side token (starts with "live_" for production, "test_" for sandbox)
# Get this from: Paddle Dashboard > Developer Tools > Authentication > Client-side tokens
VITE_PADDLE_ENVIRONMENT=production
VITE_PADDLE_CLIENT_TOKEN=live_xxxxxxxxxxxxxxxxxxxxxxxxx
